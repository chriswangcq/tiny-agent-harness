{
  "name": "tiny-agent-harness",
  "version": "0.1.0",
  "description": "An open coding agent harness with terminal/session tools and durable agent-loop traces.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tiny-agent": "dist/cli/main.js",
    "im": "dist/cli/im-entry.js",
    "skill": "dist/cli/skill-entry.js",
    "codeq": "dist/code-intel/cli.js",
    "mcp": "dist/cli/mcp-entry.js"
  },
  "scripts": {
    "build": "tsc",
    "audit:model-cache": "node scripts/model-cache-audit.mjs",
    "codeq": "node --loader ts-node/esm src/code-intel/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --loader ts-node/esm src/cli/main.ts"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "neo-blessed": "^0.2.0",
    "node-pty": "^1.2.0-beta.13",
    "wcwidth": "^1.0.1"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "typescript-language-server": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
